# Personal Claude Code settings — previously relied on a laptop-only global
# gitignore rule (~/.config/git/ignore), which doesn't travel with the repo
.claude/settings.local.json
.claude/settings.local.json.bak

# Generated outputs — rebuilt from markdown sources on demand
# PDFs for download live in assets/pdf/ (committed) not files/ (excluded)
files/PanorAIma/**/*.pdf
files/PanorAIma/**/peoples-of-iran-*.html
files/PanorAIma/**/preview-*.png
files/PanorAIma/**/preview-*.jpg

# surviving-or-living: superseded draft versions and private working notes —
# only the final fa-v4/en sources, scripts, and illustration caches are tracked
files/PanorAIma/surviving-or-living/surviving-or-living-fa.md
files/PanorAIma/surviving-or-living/surviving-or-living-fa-short.md
files/PanorAIma/surviving-or-living/surviving-or-living-fa-v2.md
files/PanorAIma/surviving-or-living/surviving-or-living-fa-v3.md
files/PanorAIma/surviving-or-living/review-notes.md
files/PanorAIma/surviving-or-living/sources-rejected.md
files/PanorAIma/surviving-or-living/sections/
files/PanorAIma/surviving-or-living/make_pdf.py

# Photo pipeline (P1.9): full-2048px source fetches (GPT-enhance input, never
# the published file), Telegram reply handoffs, and the sent-message map used
# to resolve replies back to an asset_id/stage — all transient
images/ig-queue/_source/
images/ig-queue/_inbox/
images/ig-queue/_telegram_sent.json
logs/

# Voice-profile raw corpus (tweets, Telegram export, voice notes, transcripts) — personal, never committed
files/voice/corpus/
